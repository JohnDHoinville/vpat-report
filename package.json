{
  "name": "accessibility-reporting-app",
  "version": "1.0.0",
  "description": "A web-based tool for analyzing WAVE accessibility scan results and generating comprehensive reports",
  "main": "index.html",
  "scripts": {
    "start": "npx http-server . -p 8080 -o",
    "backend:start": "bash scripts/start-backend.sh start",
    "backend:stop": "bash scripts/start-backend.sh stop",
    "backend:restart": "bash scripts/start-backend.sh restart",
    "backend:status": "bash scripts/start-backend.sh status",
    "backend:logs": "bash scripts/start-backend.sh logs",
    "backend:clean": "bash scripts/start-backend.sh clean",
    "health:check": "node api/utils/monitor.js check",
    "health:monitor": "node api/utils/monitor.js monitor",
    "health:diagnose": "node api/utils/monitor.js diagnose",
    "restart": "./restart-server.sh",
    "dashboard": "node scripts/dashboard-backend.js",
    "dashboard:dev": "concurrently \"npm start\" \"npm run backend:start\"",
    "build": "NODE_ENV=production webpack --mode production",
    "build:dev": "NODE_ENV=development webpack --mode development",
    "build:watch": "NODE_ENV=development webpack --mode development --watch",
    "build:analyze": "NODE_ENV=production webpack --mode production --analyze",
    "webpack:dev": "NODE_ENV=development webpack serve --mode development",
    "webpack:build": "NODE_ENV=development webpack --mode development --watch",
    "dev": "concurrently --names \"WEBPACK,FRONTEND,BACKEND\" --prefix-colors \"cyan,green,yellow\" \"npm run webpack:dev\" \"npm start\" \"npm run backend:start\"",
    "dev:components": "concurrently --names \"WEBPACK,BACKEND\" --prefix-colors \"cyan,yellow\" \"npm run webpack:dev\" \"npm run backend:start\"",
    "dev:fast": "npm run webpack:dev",
    "serve": "concurrently --names \"BUILD,FRONTEND,BACKEND\" --prefix-colors \"cyan,green,yellow\" \"npm run build:watch\" \"npm start\" \"npm run backend:start\"",
    "clean": "rimraf dashboard/dist node_modules/.cache",
    "clean:build": "rimraf dashboard/dist",
    "test": "echo \"No tests specified\" && exit 0",
    "a11y:axe": "axe http://localhost:8080 --dest ./reports/axe-results.json",
    "a11y:axe-dir": "axe --dir ./dist --dest ./reports/axe-results.json",
    "a11y:pa11y": "pa11y http://localhost:8080 --reporter json > ./reports/pa11y-results.json",
    "a11y:pa11y-ci": "pa11y-ci --sitemap http://localhost:8080/sitemap.xml --reporter json > ./reports/pa11y-results.json",
    "a11y:lighthouse": "lighthouse http://localhost:8080 --only-categories=accessibility --output json --output-path ./reports/lighthouse-results.json --chrome-flags='--headless'",
    "a11y:lighthouse-mobile": "lighthouse http://localhost:8080 --only-categories=accessibility --form-factor=mobile --output json --output-path ./reports/lighthouse-mobile.json --chrome-flags='--headless'",
    "a11y:ibm": "achecker http://localhost:8080 --output ./reports/ibm-results.json",
    "a11y:generate-report": "node scripts/generate-consolidated-report.js",
    "a11y:generate-html": "node scripts/html-report-generator.js",
    "a11y:export": "node scripts/export-utilities.js",
    "a11y:storage": "node scripts/report-storage.js",
    "a11y:contrast-basic": "node scripts/basic-contrast-checker.js",
    "a11y:contrast": "node scripts/contrast-analyzer.js",
    "a11y:all": "npm run a11y:axe && npm run a11y:pa11y && npm run a11y:lighthouse && npm run a11y:ibm && npm run a11y:generate-report && npm run a11y:generate-html && npm run a11y:export",
    "vpat:generate": "node scripts/vpat-generator.js",
    "vpat:generate-from-latest": "node scripts/vpat-generator.js reports/latest-accessibility-export.json",
    "vpat:batch": "node scripts/batch-vpat-generator.js",
    "a11y:full-workflow": "npm run a11y:all && npm run vpat:generate-from-latest",
    "test:playwright": "npx playwright test",
    "test:playwright:chromium": "npx playwright test --project=chromium",
    "test:playwright:firefox": "npx playwright test --project=firefox",
    "test:playwright:webkit": "npx playwright test --project=webkit",
    "test:playwright:mobile": "npx playwright test --project=mobile-chrome --project=mobile-safari",
    "test:playwright:report": "npx playwright show-report reports/playwright-html",
    "test:keyboard": "node scripts/keyboard-navigation-tester.js",
    "test:keyboard-navigation": "npx playwright test tests/playwright/keyboard-navigation.spec.js",
    "test:screen-reader": "node scripts/screen-reader-tester.js",
    "test:screen-reader-compatibility": "npx playwright test tests/playwright/screen-reader-compatibility.spec.js",
    "test:mobile": "node scripts/mobile-accessibility-tester.js",
    "test:mobile-accessibility": "npx playwright test tests/playwright/mobile-accessibility.spec.js",
    "test:form": "node scripts/form-accessibility-tester.js",
    "test:form-accessibility": "npx playwright test tests/playwright/form-accessibility.spec.js",
    "test:dynamic-content": "node scripts/dynamic-content-tester.js",
    "test:dynamic-content-playwright": "npx playwright test tests/playwright/dynamic-content.spec.js",
    "progress:baseline": "node scripts/progress-tracker.js baseline",
    "progress:report": "node scripts/progress-tracker.js progress",
    "progress:dashboard": "node scripts/progress-tracker.js dashboard",
    "test:comprehensive": "node scripts/comprehensive-test-runner.js",
    "test:run": "node scripts/comprehensive-test-runner.js",
    "auth:login": "node scripts/auth-helper.js login",
    "auth:test": "node scripts/auth-helper.js test",
    "auth:clear": "node scripts/auth-helper.js clear",
    "auth:wizard": "node scripts/auth-wizard.js setup",
    "auth:detect": "node scripts/auth-wizard.js detect",
    "test:auth": "node scripts/comprehensive-test-runner.js --use-auth"
  },
  "keywords": [
    "accessibility",
    "WCAG",
    "WAVE",
    "Section 508",
    "compliance",
    "reporting"
  ],
  "author": "Your Organization",
  "license": "MIT",
  "devDependencies": {
    "@axe-core/cli": "^4.10.2",
    "@babel/core": "^7.25.8",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-nullish-coalescing-operator": "^7.18.6",
    "@babel/plugin-proposal-object-rest-spread": "^7.20.7",
    "@babel/plugin-proposal-optional-chaining": "^7.21.0",
    "@babel/plugin-proposal-private-methods": "^7.18.6",
    "@babel/plugin-syntax-dynamic-import": "^7.8.3",
    "@babel/plugin-transform-react-constant-elements": "^7.27.1",
    "@babel/plugin-transform-react-inline-elements": "^7.27.1",
    "@babel/plugin-transform-react-jsx-self": "^7.27.1",
    "@babel/plugin-transform-react-jsx-source": "^7.27.1",
    "@babel/preset-env": "^7.25.8",
    "@babel/preset-react": "^7.25.7",
    "@playwright/test": "^1.53.1",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.6.1",
    "accessibility-checker": "^3.1.82",
    "babel-loader": "^9.2.1",
    "color-contrast-checker": "^2.1.0",
    "concurrently": "^8.2.2",
    "css-loader": "^7.1.2",
    "express": "^4.21.2",
    "html-webpack-plugin": "^5.6.3",
    "http-server": "^14.1.1",
    "lighthouse": "^11.7.1",
    "mini-css-extract-plugin": "^2.9.2",
    "pa11y": "^8.0.0",
    "pa11y-ci": "^3.1.0",
    "playwright": "^1.53.1",
    "puppeteer": "^24.15.0",
    "react-refresh": "^0.17.0",
    "rimraf": "^6.0.1",
    "style-loader": "^4.0.0",
    "webpack": "^5.97.1",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.1.0"
  },
  "dependencies": {
    "axe-core": "^4.10.2",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.2",
    "cheerio": "^1.1.0",
    "chrome-launcher": "^0.15.2",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.1",
    "node-fetch": "^3.3.2",
    "pg": "^8.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "uuid": "^11.1.0",
    "ws": "^8.18.3"
  }
}
